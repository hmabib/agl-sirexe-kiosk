GEMINI_API_KEY=
# Modèle texte/image configurable. Repli : gemini-flash-latest.
GEMINI_MODEL=gemini-3.8-flash
# Modèle compatible Live API : vérifier sa disponibilité sur le compte.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Voix studio serveur (fallback navigateur si 503)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Illustration sur mesure de l’espace créatif (repli automatique si indisponible)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# La clé reste côté serveur, jamais envoyée au navigateur.
NEXT_PUBLIC_ADMIN_PW=agl2026
