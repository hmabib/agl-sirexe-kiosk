GEMINI_API_KEY=
# Modèle texte/image configurable. Repli : gemini-flash-latest.
GEMINI_MODEL=gemini-3.8-flash
# Modèle compatible Live API : vérifier sa disponibilité sur le compte.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Voix studio serveur (fallback navigateur si 503)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Le fournisseur dépend du nom de variable, jamais du préfixe de la clé.
# Alternative texte Mistral, utilisée seulement si GEMINI_API_KEY est vide.
MISTRAL_API_KEY=
NEXT_PUBLIC_ADMIN_PW=agl2026
